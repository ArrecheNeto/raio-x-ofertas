# Raio-X de Ofertas: copie este arquivo para ".env" (na mesma pasta) e preencha.
# O .env nunca vai para o GitHub nem para a pasta publica.

# Chave da AIsa (console da AIsa > API Keys)
AISA_API_KEY=

# Senha do painel /admin.php e da /saude.php (use uma senha forte)
ADMIN_PASSWORD=troque-esta-senha

# Teto de gasto por dia, em dolares. Ao passar disso o robo para e registra.
DAILY_BUDGET_USD=2.00

# Nichos iniciais (separados por virgula). Depois voce edita no painel.
NICHOS=emagrecimento,renda extra,concursos,relacionamento,investimentos

# Quantos anuncios buscar por nicho em cada coleta (max 250)
ADS_PER_NICHE=20

# Busca extra por nicho so com anuncios de educacao (1 = sim). Costuma trazer poucos itens, quase todos infoproduto.
BUSCA_EDUCACAO=1

# Quantos anunciantes por dia recebem a contagem real de anuncios ativos (brand analytics)
ANALYTICS_TOP=20
# Na primeira vez que um anunciante entra no top, quantos dias de historico buscar (cada dia custa 1 item)
ANALYTICS_BACKFILL_DAYS=7

# Modelo de IA da AIsa (compativel com OpenAI) e preco por 1 milhao de tokens (so para estimar)
AI_MODEL=deepseek-v4.1-flash
AI_PRICE_IN=0.10
AI_PRICE_OUT=0.50
AI_MAX_TOKENS=1600
# Quantos Raio-X novos por dia, no maximo
RAIOX_POR_DIA=30

# Preco observado por item do Foreplay (anuncio ou dia de analytics). Usado para estimar antes de chamar.
PRECO_ITEM_USD=0.0175
# Teto por chamada enviado no header X-AISA-Max-Price-USD. A AIsa estima 0.875 para as rotas do Foreplay,
# entao um valor abaixo disso faz a chamada ser recusada.
MAX_PRICE_PER_CALL_USD=0.90

# Mudanca minima (30% = 0.30) para marcar ESCALANDO ou CAINDO
ESCALA_LIMIAR=0.30

# So mostrar infoprodutos na pagina publica (1 = sim, 0 = mostrar tudo)
SO_INFOPRODUTO=1

# Quanto tempo (segundos) cada execucao do cron pode trabalhar, e quantas coletas de nicho por execucao
TEMPO_MAX_EXECUCAO=25
COLETAS_POR_EXECUCAO=1

# So no computador local (Windows), se aparecer "SSL certificate problem": caminho de um ca-bundle.crt.
# Na HostGator deixe vazio.
CURL_CA_BUNDLE=

# Fuso horario
TIMEZONE=America/Sao_Paulo

# Banco: sqlite (padrao) ou mysql
DB_DRIVER=sqlite
# Se usar mysql (cPanel > Bancos de dados MySQL):
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
